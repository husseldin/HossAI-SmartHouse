# Edge Hub Agent Configuration

# Hub Identity
HUB_ID=edge-hub-01
HUB_NAME=Living Room Hub
HUB_LOCATION=Living Room

# Controller Connection
CONTROLLER_HOST=192.168.1.100
CONTROLLER_MQTT_PORT=1883
CONTROLLER_API_URL=http://192.168.1.100:8000

# MQTT Configuration
MQTT_USERNAME=edge-hub
MQTT_PASSWORD=changeme
MQTT_CLIENT_ID=edge-hub-agent

# mTLS (optional, for production)
MQTT_USE_TLS=false
MQTT_CA_CERT=/certs/ca.crt
MQTT_CLIENT_CERT=/certs/client.crt
MQTT_CLIENT_KEY=/certs/client.key

# Health Monitoring
HEALTH_CHECK_INTERVAL=30000
HEARTBEAT_INTERVAL=10000

# Protocol Adapters
ENABLE_ZIGBEE=true
ENABLE_ZWAVE=true
ENABLE_BLUETOOTH=false

# Zigbee Configuration
ZIGBEE_PORT=/dev/ttyUSB0
ZIGBEE_ADAPTER=ezsp
ZIGBEE_CHANNEL=11
ZIGBEE_PAN_ID=0x1a62

# Z-Wave Configuration
ZWAVE_PORT=/dev/ttyACM0

# Local API (for debugging)
PORT=8080
HOST=0.0.0.0

# Logging
LOG_LEVEL=info
