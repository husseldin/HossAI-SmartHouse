# Production Environment Configuration
# Copy this file to .env.production and update with your values

# =====================================================
# REQUIRED: Security Secrets
# =====================================================
# Generate secure passwords using: openssl rand -base64 32

POSTGRES_PASSWORD=CHANGE_ME_PLEASE
REDIS_PASSWORD=CHANGE_ME_PLEASE
JWT_SECRET=CHANGE_ME_PLEASE

# =====================================================
# Database Configuration
# =====================================================
POSTGRES_DB=smarthome
POSTGRES_USER=smarthome
DATABASE_URL=postgresql://smarthome:${POSTGRES_PASSWORD}@postgres:5432/smarthome

# =====================================================
# Platform Configuration
# =====================================================
PLATFORM_DOMAIN=https://smarthome.yourdomain.com
NODE_ENV=production

# =====================================================
# Rate Limiting
# =====================================================
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW=60000

# =====================================================
# MQTT Configuration
# =====================================================
MQTT_BROKER_URL=mqtt://mosquitto:1883
MQTT_USERNAME=smarthome
MQTT_PASSWORD=CHANGE_ME_PLEASE

# =====================================================
# Feature Flags
# =====================================================
ENABLE_NETWORK_SCANNING=true
ENABLE_VULNERABILITY_SCANNING=true
ENABLE_AUTOMATION=true

# =====================================================
# Logging
# =====================================================
LOG_LEVEL=info

# =====================================================
# Backup Configuration
# =====================================================
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *

# =====================================================
# Email Notifications (Optional)
# =====================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=Smart Home <smarthome@yourdomain.com>

# =====================================================
# External Services (Optional)
# =====================================================
# WEATHER_API_KEY=your-api-key
# GEOLOCATION_API_KEY=your-api-key
