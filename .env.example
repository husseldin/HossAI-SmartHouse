# =================================================================
# Smart Home Platform - Environment Configuration
# =================================================================
# Copy this file to .env and customize the values
# NEVER commit .env to version control
# =================================================================

# -----------------------------------------------------------------
# General Settings
# -----------------------------------------------------------------
NODE_ENV=production
PLATFORM_NAME=SmartHome Platform
PLATFORM_DOMAIN=localhost
TZ=America/Los_Angeles

# -----------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_generate_random_string_here
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# Admin user (created on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_strong_password_here
ADMIN_EMAIL=admin@localhost

# Encryption key for secrets at rest
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_generate_random_string_here

# -----------------------------------------------------------------
# Database - PostgreSQL
# -----------------------------------------------------------------
POSTGRES_USER=smarthome
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password_here
POSTGRES_DB=smarthome_platform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full connection string (auto-generated from above, or override)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# -----------------------------------------------------------------
# Redis - Cache & Sessions
# -----------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password_here

# -----------------------------------------------------------------
# MQTT Broker
# -----------------------------------------------------------------
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TLS_PORT=8883
MQTT_WS_PORT=9001

# MQTT Authentication
MQTT_USERNAME=smarthome
MQTT_PASSWORD=CHANGE_ME_mqtt_password_here

# -----------------------------------------------------------------
# Service Ports (Internal)
# -----------------------------------------------------------------
API_GATEWAY_PORT=8000
DEVICE_SERVICE_PORT=8001
NETWORK_SERVICE_PORT=8002
SECURITY_SERVICE_PORT=8003
AUTOMATION_ENGINE_PORT=8004
INTEGRATION_MANAGER_PORT=8005

# -----------------------------------------------------------------
# Web UI
# -----------------------------------------------------------------
WEB_UI_PORT=3000
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws

# -----------------------------------------------------------------
# Network Scanning
# -----------------------------------------------------------------
# Default network ranges to scan (comma-separated CIDR)
SCAN_DEFAULT_RANGES=192.168.1.0/24,192.168.2.0/24

# Enable/disable automatic discovery scans
SCAN_AUTO_DISCOVERY=true
SCAN_DISCOVERY_INTERVAL=3600  # seconds (1 hour)

# Nmap scan options (be conservative)
NMAP_TIMING_TEMPLATE=T3  # T0-T5, T3 is normal
NMAP_MAX_RETRIES=2

# -----------------------------------------------------------------
# Security & Vulnerability Database
# -----------------------------------------------------------------
# Enable CVE database updates
CVE_DATABASE_ENABLED=true
CVE_UPDATE_INTERVAL=86400  # seconds (24 hours)

# NVD API Key (optional, for faster CVE lookups)
# Get from: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# -----------------------------------------------------------------
# Logging
# -----------------------------------------------------------------
LOG_LEVEL=info  # error, warn, info, debug
LOG_FORMAT=json  # json or pretty

# -----------------------------------------------------------------
# Monitoring (Optional)
# -----------------------------------------------------------------
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

GRAFANA_ENABLED=false
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password

# -----------------------------------------------------------------
# Edge Hub Configuration
# -----------------------------------------------------------------
# Edge hub authentication method
EDGE_HUB_AUTH_METHOD=mtls  # mtls or token

# Token-based auth (if not using mTLS)
EDGE_HUB_TOKEN=CHANGE_ME_generate_random_token_here

# -----------------------------------------------------------------
# Integrations & Connectors
# -----------------------------------------------------------------
# Enable specific integration types
INTEGRATION_MQTT_ENABLED=true
INTEGRATION_HTTP_ENABLED=true
INTEGRATION_SSH_ENABLED=false  # Enable if you need router SSH access

# Router/Firewall Integration (optional)
ROUTER_TYPE=  # unifi, asus, openwrt, etc.
ROUTER_HOST=
ROUTER_USERNAME=
ROUTER_PASSWORD=
ROUTER_API_KEY=

# -----------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------
RATE_LIMIT_WINDOW=60000  # milliseconds
RATE_LIMIT_MAX_REQUESTS=100

# -----------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------
FEATURE_NETWORK_SCANNING=true
FEATURE_VULNERABILITY_SCANNING=true
FEATURE_TRAFFIC_MONITORING=true
FEATURE_AUTOMATION=true
FEATURE_VOICE_CONTROL=false  # Future LLM integration

# -----------------------------------------------------------------
# Development Settings (only for dev mode)
# -----------------------------------------------------------------
DEV_MOCK_DEVICES=false
DEV_MOCK_NETWORK=false
DEV_ENABLE_DEBUG_ENDPOINTS=false

# -----------------------------------------------------------------
# Backup & Recovery
# -----------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400  # seconds (24 hours)
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/data/backups
